# ============================================================
#  EcoMadelleine — Plantilla de variables de entorno
#  Copiar a .env y rellenar. El .env real NUNCA se sube a Git.
# ============================================================

APP_ENV=development
APP_TZ=America/Caracas

# --- Base de datos ---
DB_HOST=localhost
DB_NAME=db_clinica_ecografias
DB_USER=eco_app
DB_PASS=
DB_TZ_OFFSET=-04:00

# --- Firma electronica de informes (HMAC-SHA256) ---
# Generar una clave aleatoria de 64 hex y NO cambiarla despues:
#   php -r "echo bin2hex(random_bytes(32));"
ECO_FIRMA_KEY=

# --- Clave para disparar el cron por URL (?key=...) ---
ECO_CRON_KEY=

# --- SMTP (correo saliente). Vacio = el envio de correo queda desactivado. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=EcoMadelleine
MAIL_TO_EMAIL=
